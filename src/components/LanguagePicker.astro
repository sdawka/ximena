---
import { getLocaleFromUrl } from "../i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const englishPath = locale === "es" ? "../" : "./";
const spanishPath = locale === "es" ? "./" : "./es/";
---

<div class="lang-picker">
  <a href={englishPath} class:list={["lang", { active: locale === "en" }]} aria-current={locale === "en" ? "page" : undefined}>EN</a>
  <span class="sep">/</span>
  <a href={spanishPath} class:list={["lang", { active: locale === "es" }]} aria-current={locale === "es" ? "page" : undefined}>ES</a>
</div>

<style>
  .lang-picker {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .lang {
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .lang:hover {
    opacity: 0.8;
  }

  .lang.active {
    opacity: 1;
  }

  .sep {
    opacity: 0.3;
  }
</style>
