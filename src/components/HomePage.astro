    :global(.js.journey-ready) .waypoint-route { stroke-dashoffset: calc(1 - var(--section-progress)); }

    :global(.js.journey-ready) .about { min-height: 160vh; min-height: 160svh; padding: 0; }
    :global(.js.journey-ready) .about-scene { position: sticky; top: 0; min-height: 100vh; min-height: 100svh; align-content: center; }
