    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .scroll-cue svg { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-width: 1.4; }
  .scroll-handoff { opacity: 0; }

  .practice { padding: 128px 0 160px; }
  .practice-scene { display: grid; grid-template-columns: minmax(300px, 0.9fr) minmax(480px, 1.1fr); gap: clamp(48px, 7vw, 112px); }
  .practice-statement { padding-top: 48px; }
  .practice-statement h2 {
    max-width: 11ch;
    margin: 40px 0 0;
    font-size: clamp(40px, 5vw, 64px);
    font-stretch: 80%;
    font-weight: 480;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .practice-copy-mask { overflow: hidden; }
  .practice-copy-mask p {
    max-width: 52ch;
    margin: 64px 0 0;
    color: var(--muted);
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 380;
    line-height: 1.42;
    letter-spacing: -0.022em;
    text-wrap: pretty;
  }

  .align-field { position: relative; min-height: 680px; border-left: 1px solid rgba(77, 84, 74, 0.3); }
  .align-field svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .align-stream { fill: none; stroke: var(--text); stroke-width: 1.3; stroke-linecap: round; opacity: 0.58; }
  .align-stream--teams { stroke: var(--border); }
  .align-stream--timelines { stroke-dasharray: 5 8; }
  .align-route { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .align-node { fill: var(--accent); }
  .align-node-ring { fill: none; stroke: var(--accent); opacity: 0.45; }
  .align-endpoint { fill: var(--accent); }

  .align-label {
    position: absolute;
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .align-label--vision { top: 14%; left: 3%; }
  .align-label--teams { top: 40%; right: 2%; }
  .align-label--timelines { bottom: 6%; left: 22%; }
  .align-label--delivery { top: 55%; right: 2%; color: var(--text); }

  .current {
    position: absolute;
    right: 2%;
    bottom: 9%;
    display: grid;
    width: min(420px, 82%);
    grid-template-columns: 112px 1fr;
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(20, 23, 19, 0.24);
  }

  .current p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.55; text-wrap: pretty; }

  .work-band { min-height: auto; background: var(--inverse); color: var(--text-inverse); }
  .work-scene {
    display: grid;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 112px var(--page-pad) 128px;
    grid-template-columns: minmax(190px, 0.28fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
  }

  .work-navigation h2 {
    margin: 28px 0 0;
    font-size: clamp(40px, 5vw, 64px);
    font-stretch: 82%;
    font-weight: 460;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .work-navigation .eyebrow { color: #aeb5aa; }
  .waypoint-index { display: flex; height: 360px; margin-top: 64px; gap: 16px; color: #aeb5aa; }
  .waypoint-index svg { width: 48px; height: 360px; overflow: visible; }
  .waypoint-route { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .waypoint-index circle { fill: var(--inverse); stroke: #aeb5aa; stroke-width: 1.5; }
  .waypoint-index circle.is-active { fill: var(--accent); stroke: var(--accent); }
  .waypoint-index circle.is-complete { stroke: var(--accent); }
  .waypoint-index > div { display: grid; padding: 33px 0; grid-template-rows: repeat(4, 1fr); }
  .waypoint-index span { font-family: var(--ff-mono); font-size: 11px; }
  .waypoint-index span.is-active { color: var(--accent); }

  .project-theatre { position: relative; min-width: 0; margin: 0; padding: 0; list-style: none; }
  .project-theatre > li + li { margin-top: 96px; }
  .project-card { display: block; min-width: 0; }
  .project-plate { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface); }
  .plate-art { width: 100%; height: 100%; transition: transform var(--emphasis) var(--ease); }
  .plate-art svg { display: block; width: 100%; height: 100%; }
  .plate-surface { fill: var(--surface); }
  .plate-surface--dark { fill: #242821; }
  .plate-surface--light { fill: var(--elevated); }
  .plate-line, .local-contour, .aperture, .coordinate-cross, .index-rules, .leaf-vein {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .plate-letter { fill: none; stroke: var(--text); stroke-width: 118; }
  .plate-line--soft { opacity: 0.36; }
  .plate-sweep { fill: none; stroke: var(--accent); stroke-width: 24; stroke-linecap: round; }
  .oxide-disc { fill: var(--accent); transform-box: fill-box; transform-origin: center; transition: transform var(--emphasis) var(--ease); }
  .plate-coord { fill: var(--muted); font-family: var(--ff-mono); font-size: 13px; letter-spacing: 0.12em; }
  .plate-coord--light { fill: var(--text-inverse); }
  .plate-grid { fill: none; stroke: var(--text-inverse); stroke-width: 1; opacity: 0.16; }
  .local-contour--light { stroke: var(--text-inverse); }
  .north-arrow { fill: none; stroke: var(--text-inverse); stroke-width: 2; }
  .light-field { fill: var(--background); opacity: 0.5; }
  .aperture { stroke-width: 3; }
  .coordinate-cross { stroke-width: 2; }
  .index-rules { opacity: 0.5; }
  .plate-number { fill: var(--text); font-family: var(--ff-editorial); font-size: 460px; font-style: italic; opacity: 0.1; }

  .project-meta {
    display: grid;
    min-height: 64px;
    padding-top: 18px;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 24px;
    border-top: 1px solid transparent;
  }

  .project-meta > span:not(.project-name), .project-name > span {
    color: #aeb5aa;
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .project-name { display: flex; gap: 16px; font-size: clamp(20px, 2vw, 28px); letter-spacing: -0.025em; }
  .project-card:hover .plate-art, .project-card:focus-visible .plate-art { transform: translateY(-8px) scale(1.025); }
  .project-card:hover .project-meta, .project-card:focus-visible .project-meta { border-color: var(--accent); }

  .about { min-height: auto; padding: 160px 0; }
  .about-scene { min-height: 620px; display: grid; grid-template-columns: 180px 1fr; gap: clamp(32px, 6vw, 96px); align-content: center; }
  .about-lens { position: relative; overflow: hidden; }
  .about-copy {
    max-width: 960px;
    margin: 0;
    font-size: clamp(28px, 4.2vw, 64px);
    font-stretch: 82%;
    font-weight: 380;
    line-height: 1.12;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .about-copy em { color: var(--accent); }
  .about-mask { display: none; position: absolute; z-index: 2; top: 0; bottom: 0; width: 52%; background: rgba(196, 204, 191, 0.76); pointer-events: none; }
  .about-mask--left { left: 0; }
  .about-mask--right { right: 0; }
  .about-seam { display: none; position: absolute; z-index: 3; top: 0; bottom: 0; left: 50%; width: 1px; background: var(--accent); }
  .about-exit { grid-column: 2; width: 100%; margin-top: 64px; fill: none; stroke: var(--accent); stroke-width: 1.5; }
  .about-exit path { stroke-dasharray: 1; stroke-dashoffset: 0; }

  .experience { padding: 128px 0 160px; }
  .experience-title-row { display: flex; justify-content: space-between; align-items: end; margin-bottom: 48px; }
  .experience-title-row h2 { margin: 0; font-size: clamp(28px, 3vw, 40px); font-weight: 450; letter-spacing: -0.035em; }
  .trace-body { display: grid; grid-template-columns: 80px 1fr; gap: 24px; }
  .trace-route { width: 80px; height: 520px; overflow: visible; }
  .trace-route__base, .trace-route__progress { fill: none; stroke: var(--border); stroke-width: 1.5; }
  .trace-route__progress { stroke: var(--accent); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .trace-route circle { fill: var(--accent); stroke: var(--accent); stroke-width: 1.5; }
  .trace-route circle.is-traced { fill: var(--accent); stroke: var(--accent); }
  .trace-current-ring { fill: none !important; stroke: var(--accent) !important; opacity: 0.55; }
  .experience-list { margin: 0; padding: 0; list-style: none; }
  .experience-row {
    display: grid;
    min-height: 130px;
    padding: 40px 0;
    grid-template-columns: 110px 1fr 1fr minmax(140px, 220px);
    align-items: baseline;
    gap: 24px;
    border-bottom: 1px solid rgba(77, 84, 74, 0.34);
    color: var(--text);
  }
  .experience-year, .experience-location { color: var(--muted); font-family: var(--ff-mono); font-size: 11px; }
  .experience-place { font-size: 20px; letter-spacing: -0.02em; }
  .experience-role { color: var(--muted); font-size: 13px; }
  .experience-location { text-align: right; }

  .contact { min-height: auto; overflow: clip; background: var(--inverse); color: var(--text-inverse); }
  .contact-scene { max-width: var(--content-max); margin: 0 auto; padding: 96px var(--page-pad) 32px; }
  .contact .eyebrow { color: #aeb5aa; }
  .contact-action {
    position: relative;
    display: flex;
    min-height: clamp(520px, 64vw, 760px);
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .arrival-field {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(1100px, 96vw);
    overflow: visible;
    fill: none;
    stroke: var(--text-inverse);
    stroke-width: 1.2;
    transform: translate(-50%, -50%);
  }
  .arrival-strand, .arrival-orbit { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .arrival-orbit--soft { opacity: 0.3; }
  .arrival-tick { opacity: 0.6; }
  .arrival-endpoint { fill: var(--accent); stroke: none; }
  .arrival-field text { fill: #7d8678; stroke: none; font-family: var(--ff-mono); font-size: 11px; letter-spacing: 0.12em; }
  .contact-title {
    position: relative;
    z-index: 2;
    margin: 0;
    font-size: clamp(72px, 14vw, 214px);
    font-stretch: 72%;
    font-weight: 500;
    line-height: 0.86;
    letter-spacing: -0.055em;
    text-align: center;
    text-wrap: balance;
  }
  .email {
    position: relative;
    z-index: 3;
    display: inline-flex;
    min-height: 48px;
    margin-top: 48px;
    align-items: center;
    overflow: hidden;
    font-size: clamp(16px, 2vw, 28px);
    letter-spacing: -0.02em;
  }
  .email::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(1);
    transform-origin: left;
  }
  .contact-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid rgba(233, 237, 230, 0.26);
    color: #aeb5aa;
    font-family: var(--ff-mono);
    font-size: 11px;
  }

  @media (min-width: 1024px) {
