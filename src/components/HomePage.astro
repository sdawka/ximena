---
import Layout from "../layouts/Layout.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { getLocaleFromUrl, useTranslations } from "../i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const projects = [
  { n: "01", name: "Fintech Rebrand", tag: "Strategy", year: "2025" },
  { n: "02", name: "Museo Digital", tag: "Digital", year: "2024" },
  { n: "03", name: "Vertex Studio", tag: "Operations", year: "2024" },
  { n: "04", name: "Marca Ciudad", tag: "Branding", year: "2023" },
];

const experience = [
  { yr: "2024 —", place: "Independent", role: t.experience.roles.project_lead, loc: "Ciudad de México" },
  { yr: "2021 — 24", place: "Estudio Raíz", role: t.experience.roles.senior_pm, loc: "Ciudad de México" },
  { yr: "2018 — 21", place: "Ideame", role: t.experience.roles.operations, loc: "Buenos Aires" },
  { yr: "2014 — 18", place: "ITAM", role: t.experience.roles.degree, loc: "Ciudad de México" },
];

const railStages = ["ORIENT", "ALIGN", "NAVIGATE", "TRACE", "ARRIVE"];
---

<Layout title={t.meta.title} locale={locale}>
  <a class="skip-link" href="#work">{t.work.skip}</a>

  <div class="atmosphere" aria-hidden="true">
    <span class="ink-bloom ink-bloom--oxide"></span>
    <span class="ink-bloom ink-bloom--graphite"></span>
    <svg class="grain" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      <filter id="paper-grain">
        <feTurbulence type="fractalNoise" baseFrequency="0.78" numOctaves="2" seed="18" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100" height="100" filter="url(#paper-grain)" opacity="0.8" />
    </svg>
    <svg class="journey-handoff" viewBox="0 0 1440 1000" fill="none" focusable="false">
      <path pathLength="1" d="M-100 188c221-151 390-96 515 31 136 139 276 132 412 5 161-151 331-111 713 99" />
      <path class="journey-handoff__oxide" pathLength="1" d="M42 881c163-181 332-201 456-76 131 133 246 81 347-25 123-128 269-122 546 30" />
    </svg>
  </div>

  <div class="journey-rail" aria-hidden="true">
    {railStages.map((stage, index) => (
      <div class="journey-rail__stage" data-rail-stage={index}>
        <span>{stage}</span><i></i>
      </div>
    ))}
  </div>

  <div class="custom-cursor" aria-hidden="true">
    <span class="cursor-core"></span><span class="cursor-label">VIEW</span>
  </div>

  <main class="portfolio">
    <header class="top">
      <div class="mark">Ximena Alvarez Sosa</div>
      <div class="top-right">
        <LanguagePicker />
        <div class="status"><span class="status-dot"></span>{t.header.available}</div>
      </div>
    </header>

    <section
      class="hero journey-section"
      id="orient"
      aria-labelledby="hero-title"
      data-journey
      data-stage="orient"
      style="--section-progress: 1"
    >
      <div class="hero-scene journey-scene" data-hero>
        <svg class="orient-field" viewBox="0 0 1200 720" aria-hidden="true" focusable="false">
          <g class="orient-ticks">
            <path d="M98 96h28M112 82v28M1040 594h28M1054 580v28M854 124h20M864 114v20" />
            <circle cx="112" cy="96" r="4" />
            <circle cx="1054" cy="594" r="4" />
          </g>
          <path class="orient-path orient-path--one" pathLength="1" d="M-20 174c168-112 290-92 386 3 93 91 175 107 282 38" />
          <path class="orient-path orient-path--two" pathLength="1" d="M511 637c60-151 184-219 296-146 96 62 126 141 296 126" />
          <path class="orient-path orient-path--three" pathLength="1" d="M814 90c-80 91-91 176-23 239 58 53 146 47 252 126" />
          <path class="orient-resolved" pathLength="1" d="M366 177c93 91 175 107 282 38 83-53 99-106 166-125" />
          <g class="orient-beacon">
            <circle r="12" />
            <circle class="orient-beacon-ring" r="27" />
          </g>
          <g class="orient-compass">
            <ellipse cx="600" cy="350" rx="472" ry="216" />
            <path d="M600 134v-28M586 116h28" />
          </g>
        </svg>

        <h1 id="hero-title">
          <span class="hero-line hero-line--one"><span>{t.hero.designer}</span></span>
          <span class="hero-line hero-line--two"><span>{t.hero.of} <em>{t.hero.quiet}</em>,</span></span>
          <span class="hero-line hero-line--three">
            <span>{t.hero.considered}</span>
            <small class="practice-pill">{t.hero.pill}</small>
          </span>
          <span class="hero-line hero-line--four"><span><em>{t.hero.systems}</em></span></span>
        </h1>

        <a class="scroll-cue" href="#work" data-cursor="VIEW">
          <span>{t.work.action}</span>
          <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path class="scroll-arrow" d="M24 8v29M16 29l8 8 8-8" />
            <path class="scroll-handoff" d="M3 24h42" />
          </svg>
        </a>
      </div>
    </section>

    <section
      class="practice journey-section"
      id="align"
      aria-labelledby="practice-title"
      data-journey
      data-stage="align"
      style="--section-progress: 1"
    >
      <div class="practice-scene journey-scene">
        <div class="practice-statement">
          <p class="eyebrow">{t.practice.label}</p>
          <h2 id="practice-title">{t.practice.title}</h2>
          <div class="practice-copy-mask">
            <p set:html={t.practice.text} />
          </div>
        </div>

        <div class="align-field">
          <svg viewBox="0 0 720 720" aria-hidden="true" focusable="false">
            <path class="align-stream align-stream--vision" d="M-30 132c174 0 183 178 340 178" />
            <path class="align-stream align-stream--teams" d="M750 306c-190 0-216 4-440 4" />
            <path class="align-stream align-stream--timelines" d="M210 754c0-213 100-272 100-444" />
            <path class="align-route" pathLength="1" d="M310 310c93 0 123 63 188 63h222" />
            <circle class="align-node" cx="310" cy="310" r="11" />
            <circle class="align-node-ring" cx="310" cy="310" r="23" />
            <circle class="align-endpoint" cx="510" cy="373" r="8" />
          </svg>
          <span class="align-label align-label--vision">{t.journey.align.vision}</span>
          <span class="align-label align-label--teams">{t.journey.align.teams}</span>
          <span class="align-label align-label--timelines">{t.journey.align.timelines}</span>
          <span class="align-label align-label--delivery">{t.journey.align.delivery}</span>

          <div class="current">
            <span class="eyebrow">{t.currently.label}</span>
            <p>{t.currently.text}</p>
          </div>
        </div>
      </div>
    </section>

    <section
      class="work-band full-bleed journey-section"
      id="work"
      aria-labelledby="work-title"
      data-journey
      data-stage="navigate"
      style="--section-progress: 1"
    >
      <div class="work-scene journey-scene">
        <aside class="work-navigation">
          <p class="eyebrow">{t.work.label}</p>
          <h2 id="work-title">{t.work.title} <em>{t.work.titleEm}</em></h2>
          <div class="waypoint-index" aria-hidden="true">
            <svg viewBox="0 0 48 360" focusable="false">
              <path class="waypoint-route" pathLength="1" d="M24 18V342" />
              {projects.map((project, index) => <circle data-waypoint-node={index} cx="24" cy={42 + index * 92} r="6" />)}
            </svg>
            <div>
              {projects.map((project, index) => <span data-waypoint-label={index}>{project.n}</span>)}
            </div>
          </div>
        </aside>

        <ol class="project-theatre">
          {projects.map((project, index) => (
            <li>
              <a
                href="#contact"
                class="project-card"
                data-project={index}
                aria-label={`${t.work.view} ${project.name}, ${project.tag}, ${project.year}`}
                data-cursor="VIEW"
              >
                <div class="project-plate">
                  <div class="plate-art">
                    {project.n === "01" && (
                      <svg viewBox="0 0 1200 680" aria-hidden="true" focusable="false">
                        <rect width="1200" height="680" class="plate-surface" />
                        <circle class="plate-letter" cx="174" cy="338" r="294" />
                        <circle class="plate-line" cx="810" cy="340" r="216" />
                        <circle class="plate-line plate-line--soft" cx="810" cy="340" r="154" />
                        <circle class="plate-line" cx="810" cy="340" r="92" />
                        <path class="local-contour" d="M-20 540c191-175 348-170 474-48 139 134 248 133 373 8 111-111 224-127 393-37" />
                        <path class="plate-sweep" d="M811 124A216 216 0 0 1 1003 437" />
                        <circle class="oxide-disc" cx="1066" cy="142" r="32" />
                        <text class="plate-coord" x="1018" y="624">F / 01 · 19.43 N</text>
                      </svg>
                    )}
                    {project.n === "02" && (
                      <svg viewBox="0 0 1200 680" aria-hidden="true" focusable="false">
                        <rect width="1200" height="680" class="plate-surface plate-surface--dark" />
                        <g class="plate-grid">
                          <path d="M130 0v680M310 0v680M490 0v680M670 0v680M850 0v680M1030 0v680" />
                          <path d="M0 110h1200M0 220h1200M0 330h1200M0 440h1200M0 550h1200" />
                        </g>
                        <path class="local-contour local-contour--light" d="M-24 578c171-100 251-226 370-206 120 20 136 176 283 122 133-48 169-240 320-228 95 8 135 91 275 97" />
                        <path class="north-arrow" d="M600 102 521 358l79-46 79 46-79-256Zm0 210v244" />
                        <circle class="oxide-disc" cx="600" cy="548" r="30" />
                        <text class="plate-coord plate-coord--light" x="58" y="65">M / 02</text>
                        <text class="plate-coord plate-coord--light" x="984" y="626">TRUE NORTH</text>
                      </svg>
                    )}
                    {project.n === "03" && (
                      <svg viewBox="0 0 1200 680" aria-hidden="true" focusable="false">
                        <rect width="1200" height="680" class="plate-surface plate-surface--light" />
                        <circle class="light-field" cx="600" cy="340" r="244" />
                        <path class="aperture" d="M290 340a310 310 0 0 1 525-224M910 340a310 310 0 0 1-523 227M600 30a310 310 0 0 1 268 465M600 650A310 310 0 0 1 332 185" />
                        <path class="local-contour" d="M-30 542c187-64 277-230 429-188 126 34 147 197 280 161 138-37 202-199 551-99" />
                        <path class="coordinate-cross" d="M600 300v80M560 340h80" />
                        <circle class="oxide-disc" cx="600" cy="340" r="24" />
                        <text class="plate-coord" x="54" y="67">V / 03 · SYSTEM STUDY</text>
                      </svg>
                    )}
                    {project.n === "04" && (
                      <svg viewBox="0 0 1200 680" aria-hidden="true" focusable="false">
                        <rect width="1200" height="680" class="plate-surface" />
                        <g class="index-rules">
                          <path d="M70 104h284M70 150h194M70 196h310M70 242h234M70 288h278" />
                          <path d="M88 92v208M122 92v208M156 92v208" />
                        </g>
                        <text class="plate-number" x="718" y="630">04</text>
                        <path class="leaf-loop local-contour" d="M430 394c98-209 295-263 425-145 110 100 35 279-137 285-170 5-231-123-149-240 69-98 191-109 257-40" />
                        <path class="leaf-vein" d="M488 478c115-64 219-132 338-224" />
                        <circle class="oxide-disc" cx="487" cy="478" r="28" />
                        <text class="plate-coord" x="70" y="622">CITY INDEX / 04</text>
                      </svg>
                    )}
                  </div>
                </div>
                <div class="project-meta">
                  <span class="project-name"><span>{project.n}</span>{project.name}</span>
                  <span>{project.tag}</span>
                  <span>{project.year}</span>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section
      class="about journey-section"
      id="about"
      aria-labelledby="about-title"
      data-journey
      data-stage="reveal"
      style="--section-progress: 1"
    >
      <div class="about-scene journey-scene">
        <p class="eyebrow">{t.about.label}</p>
        <div class="about-lens">
          <h2 id="about-title" class="about-copy" set:html={t.about.text} />
          <div class="about-mask about-mask--left" aria-hidden="true"></div>
          <div class="about-mask about-mask--right" aria-hidden="true"></div>
          <span class="about-seam" aria-hidden="true"></span>
        </div>
        <svg class="about-exit" viewBox="0 0 1000 110" aria-hidden="true" focusable="false">
          <path pathLength="1" d="M0 78c191-62 311-58 451-6 154 57 293 44 549-37" />
        </svg>
      </div>
    </section>

    <section
      class="experience journey-section"
      id="trace"
      aria-labelledby="experience-title"
      data-journey
      data-stage="trace"
      style="--section-progress: 1"
    >
      <div class="trace-scene journey-scene">
        <div class="experience-title-row">
          <p class="eyebrow">{t.experience.label}</p>
          <h2 id="experience-title">{t.experience.title}</h2>
        </div>

        <div class="trace-body">
          <svg class="trace-route" viewBox="0 0 80 520" aria-hidden="true" focusable="false">
            <path class="trace-route__base" d="M40 470V50" />
            <path class="trace-route__progress" pathLength="1" d="M40 470V50" />
            <circle data-trace-node="3" cx="40" cy="458" r="7" />
            <circle data-trace-node="2" cx="40" cy="326" r="7" />
            <circle data-trace-node="1" cx="40" cy="194" r="7" />
            <circle data-trace-node="0" cx="40" cy="62" r="7" />
            <circle class="trace-current-ring" cx="40" cy="62" r="17" />
          </svg>

          <ol class="experience-list">
            {experience.map((entry, index) => (
              <li class="experience-row" data-experience={index}>
                <span class="experience-year">{entry.yr}</span>
                <span class="experience-place">{entry.place}</span>
                <span class="experience-role">{entry.role}</span>
                <span class="experience-location">{entry.loc}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <footer
      class="contact full-bleed journey-section"
      id="contact"
      data-contact
      data-journey
      data-stage="arrive"
      style="--section-progress: 1"
    >
      <div class="contact-scene journey-scene">
        <p class="eyebrow">{t.footer.prompt}</p>
        <div class="contact-action">
          <svg class="arrival-field" viewBox="0 0 1200 620" aria-hidden="true" focusable="false">
            <path class="arrival-strand arrival-strand--one" pathLength="1" d="M-30 96c220 0 271 112 438 214" />
            <path class="arrival-strand arrival-strand--two" pathLength="1" d="M1230 100c-240 14-282 116-438 210" />
            <path class="arrival-strand arrival-strand--three" pathLength="1" d="M-30 562c216-23 279-135 438-252" />
            <path class="arrival-strand arrival-strand--four" pathLength="1" d="M1230 570c-244-17-293-148-438-260" />
            <ellipse class="arrival-orbit" pathLength="1" cx="600" cy="310" rx="438" ry="194" />
            <ellipse class="arrival-orbit arrival-orbit--soft" pathLength="1" cx="600" cy="310" rx="376" ry="154" />
            <path class="arrival-tick" d="M600 116V86M586 96h28" />
            <circle class="arrival-endpoint" cx="970" cy="426" r="8" />
            <text x="165" y="530">19.4326° N / 99.1332° W</text>
          </svg>
          <h2 class="contact-title">{t.footer.cta}<em>{t.footer.ctaEm === "." ? t.footer.ctaEm : ` ${t.footer.ctaEm}`}</em></h2>
          <a class="email" href="mailto:hola@ximena.mx" data-cursor="MAIL">hola@ximena.mx</a>
        </div>
        <div class="contact-meta">
          <span>{t.footer.copyright}</span>
          <span>{t.footer.coords}</span>
          <span>{t.footer.status}</span>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .skip-link {
    position: fixed;
    z-index: 80;
    top: 8px;
    left: 8px;
    min-height: 48px;
    padding: 14px 18px;
    background: var(--elevated);
    color: var(--text);
    font-family: var(--ff-mono);
    font-size: 13px;
    transform: translateY(-140%);
    transition: transform var(--fast) var(--ease);
  }

  .skip-link:focus { transform: translateY(0); }

  .atmosphere {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .ink-bloom {
    position: absolute;
    width: min(900px, 72vw);
    aspect-ratio: 1;
    border-radius: 9999px;
    opacity: 0.2;
  }

  .ink-bloom--oxide {
    top: -35vw;
    right: -18vw;
    background: radial-gradient(circle, rgba(225, 87, 45, 0.26), rgba(225, 87, 45, 0) 70%);
  }

  .ink-bloom--graphite {
    bottom: -44vw;
    left: -24vw;
    background: radial-gradient(circle, rgba(23, 26, 22, 0.22), rgba(23, 26, 22, 0) 70%);
  }

  .grain { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.028; mix-blend-mode: multiply; }

  .journey-handoff {
    position: absolute;
    top: 88px;
    left: 50%;
    width: max(1024px, 108vw);
    height: auto;
    fill: none;
    stroke: var(--text);
    stroke-width: 1.25;
    stroke-linecap: round;
    opacity: 0.18;
    transform: translateX(-50%);
    mix-blend-mode: multiply;
  }

  .journey-handoff path { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .journey-handoff__oxide { stroke: var(--accent); }
  :global(.js.journey-ready) .journey-handoff path { stroke-dashoffset: calc(1 - var(--page-progress)); }

  .journey-rail {
    display: none;
    position: fixed;
    z-index: 40;
    top: 50%;
    right: 16px;
    gap: 16px;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .journey-rail__stage {
    display: grid;
    grid-template-columns: auto 12px;
    align-items: center;
    gap: 10px;
    color: var(--subtle);
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .journey-rail__stage i {
    width: 9px;
    height: 9px;
    border: 1px solid currentColor;
    border-radius: 9999px;
  }

  .journey-rail__stage.is-active { color: var(--accent); }
  .journey-rail__stage.is-active i { background: var(--accent); }
  .journey-rail__stage.is-complete { color: var(--muted); }

  .custom-cursor {
    display: none;
    position: fixed;
    z-index: 70;
    top: 0;
    left: 0;
    width: 30px;
    height: 30px;
    border: 1px solid var(--text);
    border-radius: 9999px;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(var(--cursor-x, -60px), var(--cursor-y, -60px), 0) translate(-50%, -50%) scale(var(--cursor-scale, 1));
    transition: transform var(--base) var(--ease), opacity var(--fast) linear;
  }

  .cursor-core {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--accent);
    transform: translate(-50%, -50%);
  }

  .cursor-label {
    position: absolute;
    top: 50%;
    left: 50%;
    color: var(--text);
    font-family: var(--ff-mono);
    font-size: 7px;
    letter-spacing: 0.08em;
    opacity: 0;
    transform: translate(-50%, -50%);
  }

  .custom-cursor.is-visible { opacity: 1; }
  .custom-cursor.is-active { --cursor-scale: 2; background: var(--elevated); }
  .custom-cursor.is-active .cursor-core { opacity: 0; }
  .custom-cursor.is-active .cursor-label { opacity: 1; }

  .portfolio {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 40px var(--page-pad) 0;
  }

  .top {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
  }

  .top-right { display: flex; align-items: center; gap: 24px; }
  .mark { font-size: 16px; font-weight: 560; letter-spacing: -0.02em; }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--success);
    box-shadow: 0 0 0 3px rgba(63, 125, 79, 0.18);
    animation: availability 2.4s ease-in-out infinite;
  }

  @keyframes availability { 50% { box-shadow: 0 0 0 7px rgba(63, 125, 79, 0); } }

  .journey-section { position: relative; }
  .journey-scene { position: relative; }
  .full-bleed { width: 100vw; margin-left: calc(50% - 50vw); }

  .eyebrow {
    margin: 0;
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.11em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero { min-height: min(850px, calc(100vh - 88px)); }
  .hero-scene { min-height: min(850px, calc(100vh - 88px)); padding-top: clamp(72px, 10vh, 128px); isolation: isolate; }

  .hero h1 {
    position: relative;
    z-index: 2;
    margin: 0;
    font-size: clamp(72px, 14vw, 214px);
    font-stretch: 72%;
    font-weight: 510;
    line-height: 0.82;
    letter-spacing: -0.055em;
  }

  .hero-line { display: flex; width: 100%; align-items: baseline; gap: 0.18em; }
  .hero-line--two, .hero-line--four { justify-content: flex-end; }
  .hero-line em,
  .work-navigation em,
  .about-copy em,
  .contact-title em,
  .practice-copy-mask em { font-family: var(--ff-editorial); font-style: italic; font-weight: 400; }

  .practice-pill {
    padding: 11px 18px;
    border: 1px solid var(--text);
    border-radius: 9999px;
    font-family: var(--ff-display);
    font-size: clamp(11px, 1.25vw, 20px);
    font-stretch: 100%;
    font-weight: 440;
    letter-spacing: 0;
    line-height: 1;
    white-space: nowrap;
  }

  .orient-field {
    position: absolute;
    z-index: 1;
    top: 2%;
    left: 50%;
    width: max(900px, 88vw);
    max-width: 1280px;
    overflow: visible;
    transform: translateX(-50%) translate(var(--pointer-x, 0), var(--pointer-y, 0));
    mix-blend-mode: multiply;
  }

  .orient-field path,
  .orient-field ellipse,
  .orient-field circle { vector-effect: non-scaling-stroke; }
  .orient-ticks { fill: none; stroke: var(--text); stroke-width: 1; opacity: 0.34; }
  .orient-path { fill: none; stroke: var(--text); stroke-width: 1.35; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .orient-resolved { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .orient-beacon { transform: translate(600px, 350px); }
  .orient-beacon circle:first-child { fill: var(--accent); }
  .orient-beacon-ring { fill: none; stroke: var(--accent); opacity: 0.42; }
  .orient-compass { fill: none; stroke: var(--text); stroke-width: 1.2; transform-origin: 600px 350px; }

  .scroll-cue {
    position: absolute;
    z-index: 3;
    bottom: 40px;
    left: 0;
    display: inline-flex;
