    .work-scene { grid-template-columns: 1fr; padding-top: 96px; padding-bottom: 112px; }
    .waypoint-index { display: none; }
    .project-theatre { grid-template-columns: 1fr; gap: 72px; margin-top: 32px; }
    .project-card { opacity: 1; transform: none; clip-path: none; }
    :global(.js.journey-ready) .project-card:not(.is-seen) .project-plate { clip-path: inset(0 0 100% 0); }
    :global(.js.journey-ready) .project-card .project-plate { transition: clip-path var(--sequence) var(--ease); }
    .project-meta { grid-template-columns: 1fr auto; gap: 8px 16px; }
    .project-meta > span:last-child { grid-column: 2; }
    .project-name { grid-row: 1 / span 2; }
    .about { min-height: auto; padding: 112px 0 96px; }
    .about-scene { min-height: auto; grid-template-columns: 1fr; gap: 40px; }
    .about-exit { grid-column: 1; margin-top: 0; }
    .about-exit path { stroke: var(--accent); stroke-width: 3; }
    .experience { min-height: auto; padding: 96px 0 112px; }
    .experience-title-row { align-items: flex-start; flex-direction: column; gap: 24px; }
    .trace-body { grid-template-columns: 44px 1fr; gap: 12px; }
    .trace-route { width: 44px; }
    .experience-row { min-height: 130px; grid-template-columns: 64px 1fr; gap: 12px; }
    .experience-role { grid-column: 2; }
    .contact { min-height: auto; }
    :global(.js.journey-ready) .contact { min-height: 120vh; min-height: 120svh; }
    :global(.js.journey-ready) .contact-scene { position: sticky; top: 0; min-height: 100vh; min-height: 100svh; }
    .contact-scene { padding-top: 64px; }
    .contact-action { min-height: 460px; }
    .arrival-field { width: 160vw; }
    .contact-title { font-size: clamp(72px, 24vw, 112px); }
    .contact-meta { flex-direction: column; padding-bottom: 8px; }
  }

  @media (max-width: 359px) {
    .hero h1 { font-size: 72px; }
    .mark { max-width: 116px; }
    .project-name { gap: 8px; font-size: 18px; }
    .align-label--delivery { max-width: 110px; text-align: right; }
  }

  @media (hover: hover) and (pointer: fine) {
    :global(body) { cursor: none; }
    .custom-cursor { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-rail, .custom-cursor { display: none !important; }
    .status-dot, .trace-current-ring { animation: none !important; }
    .journey-handoff path, .orient-path, .orient-resolved, .align-route, .waypoint-route,
    .about-exit path, .trace-route__progress, .arrival-strand, .arrival-orbit { stroke-dashoffset: 0 !important; }
    .hero-line, .orient-compass, .orient-beacon, .align-stream, .practice-copy-mask p, .current,
    .project-card, .about-mask, .about-seam, .experience-row, .arrival-field, .arrival-endpoint,
    .contact-title, .email, .email::after {
      opacity: 1 !important;
      clip-path: none !important;
      transform: none !important;
    }
    .about-mask, .about-seam { display: none !important; }
    .arrival-field { transform: translate(-50%, -50%) !important; }
    .email::after { transform: scaleX(1) !important; }
    :global(body) { cursor: auto !important; }
  }
</style>

<script>
  const root = document.documentElement;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const journeySections = Array.from(document.querySelectorAll<HTMLElement>("[data-journey]"));
  const railStages = Array.from(document.querySelectorAll<HTMLElement>("[data-rail-stage]"));
  const projectCards = Array.from(document.querySelectorAll<HTMLElement>("[data-project]"));
  const waypointNodes = Array.from(document.querySelectorAll<SVGCircleElement>("[data-waypoint-node]"));
  const waypointLabels = Array.from(document.querySelectorAll<HTMLElement>("[data-waypoint-label]"));
  const experienceRows = Array.from(document.querySelectorAll<HTMLElement>("[data-experience]"));
  const traceNodes = Array.from(document.querySelectorAll<SVGCircleElement>("[data-trace-node]"));
  const stageOrder: Record<string, number> = { orient: 0, align: 1, navigate: 2, reveal: 2, trace: 3, arrive: 4 };

  type JourneyGeometry = { element: HTMLElement; top: number; height: number; runway: number };
  let geometry: JourneyGeometry[] = [];
  let viewportHeight = window.innerHeight;
  let frame = 0;
  let forcedProject = -1;

  const clamp = (value: number) => Math.min(Math.max(value, 0), 1);

  const measure = () => {
    viewportHeight = window.innerHeight;
    geometry = journeySections.map((element) => {
      const rect = element.getBoundingClientRect();
      const height = element.offsetHeight;
      return {
        element,
        top: rect.top + window.scrollY,
        height,
        runway: Math.max(height - viewportHeight, 1),
      };
    });
  };

  const setProject = (activeIndex: number) => {
    projectCards.forEach((card, index) => {
      card.classList.toggle("is-active", index === activeIndex);
      card.classList.toggle("is-before", index < activeIndex);
      card.classList.toggle("is-after", index > activeIndex);
    });
    waypointNodes.forEach((node, index) => {
      node.classList.toggle("is-active", index === activeIndex);
      node.classList.toggle("is-complete", index < activeIndex);
    });
    waypointLabels.forEach((label, index) => label.classList.toggle("is-active", index === activeIndex));
  };

  const setTrace = (progress: number) => {
    const thresholds = [0.82, 0.6, 0.36, 0.14];
    experienceRows.forEach((row, index) => row.classList.toggle("is-traced", progress >= thresholds[index]));
    traceNodes.forEach((node) => {
      const index = Number(node.dataset.traceNode);
      node.classList.toggle("is-traced", progress >= thresholds[index]);
    });
  };

  const updateDirector = () => {
    const scrollY = window.scrollY;
    const scrollRange = Math.max(document.documentElement.scrollHeight - viewportHeight, 1);
    const reads = geometry.map((item) => ({
      ...item,
      progress: clamp((scrollY - item.top) / item.runway),
    }));

    let activeRail = 0;
    const probe = scrollY + viewportHeight * 0.46;
    reads.forEach((item) => {
      item.element.style.setProperty("--section-progress", item.progress.toFixed(4));
      item.element.style.setProperty("--section-active", probe >= item.top && probe <= item.top + item.height ? "1" : "0");
      if (probe >= item.top) activeRail = stageOrder[item.element.dataset.stage ?? "orient"] ?? activeRail;
    });
    root.style.setProperty("--page-progress", clamp(scrollY / scrollRange).toFixed(4));

    railStages.forEach((stage, index) => {
      stage.classList.toggle("is-active", index === activeRail);
      stage.classList.toggle("is-complete", index < activeRail);
    });

    const workState = reads.find((item) => item.element.dataset.stage === "navigate");
    if (workState) {
      const activeProject = forcedProject >= 0 ? forcedProject : Math.min(3, Math.floor(Math.min(workState.progress, 0.9999) * 4));
      setProject(activeProject);
    }

    const traceState = reads.find((item) => item.element.dataset.stage === "trace");
    if (traceState) setTrace(traceState.progress);
    frame = 0;
  };

  const queueUpdate = () => {
    if (!frame) frame = requestAnimationFrame(updateDirector);
  };

  if (!reducedMotion) {
    root.classList.add("journey-ready");
    measure();
    updateDirector();

    window.addEventListener("scroll", queueUpdate, { passive: true });
    window.addEventListener("resize", () => {
      measure();
      queueUpdate();
    }, { passive: true });

    const mobileReveal = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-seen");
          mobileReveal.unobserve(entry.target);
        }
      });
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
    projectCards.forEach((card) => mobileReveal.observe(card));

    projectCards.forEach((card, index) => {
      card.addEventListener("focus", () => {
        forcedProject = index;
        setProject(index);
      });
      card.addEventListener("blur", () => {
        forcedProject = -1;
        queueUpdate();
      });
    });
  } else {
    root.classList.add("journey-reduced");
    projectCards.forEach((card) => card.classList.add("is-active", "is-seen"));
    experienceRows.forEach((row) => row.classList.add("is-traced"));
    traceNodes.forEach((node) => node.classList.add("is-traced"));
  }

  if (finePointer && !reducedMotion) {
    const cursor = document.querySelector<HTMLElement>(".custom-cursor");
    const cursorLabel = cursor?.querySelector<HTMLElement>(".cursor-label");
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    let pointerFrame = 0;
    let pointerX = -60;
    let pointerY = -60;

    window.addEventListener("pointermove", (event) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!pointerFrame) {
        pointerFrame = requestAnimationFrame(() => {
          cursor?.style.setProperty("--cursor-x", `${pointerX}px`);
          cursor?.style.setProperty("--cursor-y", `${pointerY}px`);
          cursor?.classList.add("is-visible");
          pointerFrame = 0;
        });
      }
    }, { passive: true });

    document.addEventListener("pointerover", (event) => {
      const action = (event.target as Element).closest<HTMLElement>("a[data-cursor]");
      cursor?.classList.toggle("is-active", Boolean(action));
      if (action && cursorLabel) cursorLabel.textContent = action.dataset.cursor ?? "VIEW";
    });

    document.addEventListener("pointerleave", () => cursor?.classList.remove("is-visible"));
    hero?.addEventListener("pointermove", (event) => {
      const rect = hero.getBoundingClientRect();
      hero.style.setProperty("--pointer-x", `${(((event.clientX - rect.left) / rect.width - 0.5) * 8).toFixed(2)}px`);
      hero.style.setProperty("--pointer-y", `${(((event.clientY - rect.top) / rect.height - 0.5) * 8).toFixed(2)}px`);
    }, { passive: true });
    hero?.addEventListener("pointerleave", () => {
      hero.style.setProperty("--pointer-x", "0px");
      hero.style.setProperty("--pointer-y", "0px");
    });
  }
</script>
