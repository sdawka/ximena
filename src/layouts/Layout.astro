---
import type { Locale } from "../i18n/utils";

interface Props {
  title: string;
  locale?: Locale;
}

const { title, locale = "en" } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="The independent project leadership practice of Ximena Alvarez Sosa, connecting strategy, design, and execution."
    />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62.5..125,100..900&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    --background: #c4ccbf;
    --surface: #dde2da;
    --elevated: #f0f2ed;
    --inverse: #171a16;
    --text: #141713;
    --text-inverse: #e9ede6;
    --muted: #4d544a;
    --subtle: #7d8678;
    --border: #929b8d;
    --accent: #e1572d;
    --success: #3f7d4f;
    --ff-display: "Archivo", "Arial Narrow", sans-serif;
    --ff-editorial: "Newsreader", Georgia, serif;
    --ff-mono: "IBM Plex Mono", monospace;
    --page-pad: clamp(16px, 4.5vw, 80px);
    --content-max: 1440px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --fast: 120ms;
    --base: 300ms;
    --emphasis: 500ms;
    --sequence: 900ms;
    --page-progress: 0;
    --contour-progress: 1;
  }

  html {
    margin: 0;
    padding: 0;
    scroll-behavior: smooth;
    scroll-padding-top: 24px;
    overflow-x: clip;
    background: var(--background);
  }

  body {
    min-width: 320px;
    margin: 0;
    padding: 0;
    overflow-x: clip;
    background: var(--background);
    color: var(--text);
    font-family: var(--ff-display);
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  ::selection {
    background: var(--accent);
    color: var(--inverse);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 1ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 1ms !important;
      transition-delay: 0ms !important;
    }
  }
</style>
